# Ashle Cloud Kitchen Configuration

# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ashle_db

# Jules AI Integration
JULES_API_KEY=your-jules-api-key-here
JULES_ENABLED=true

# GitHub Integration
GITHUB_TOKEN=your-github-token-here
GITHUB_REPO=getjeevan/ashle

# Features
ENABLE_ANALYTICS=true
ENABLE_WASTE_TRACKING=true
ENABLE_MULTI_BRAND=true
